# Copy this file to backend/.env and fill in real values for local development.
# Django reads backend/.env first; it only falls back to backend/venv/.env if
# backend/.env doesn't exist (see backend/settings.py) -- prefer this file.

# Django
SECRET_KEY=change-me-to-a-random-secret-value
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS / CSRF (comma-separated). Must include the Next.js dev origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The Next.js frontend origin, used to build links in outgoing emails
# (password reset) and the certificate QR-code verification URL.
FRONTEND_URL=http://localhost:3000

# Email (Mailgun via django-anymail). Leave as placeholders in dev --
# password-reset falls back to returning the reset link/OTP in the API
# response when DEBUG=True and sending fails.
MAILGUN_DOMAIN=your_mailgun_domain
MAILGUN_API_KEY=your_mailgun_api_key
MAILERSEND_API_TOKEN=your_mailersend_api_token
FROM_EMAIL=noreply@example.com

# Database: this project defaults to SQLite (db.sqlite3) and does not
# require any of these unless you switch DATABASES in settings.py to
# something that reads them.
# DATABASE_URL=postgres://user:password@localhost:5432/naa_lms
